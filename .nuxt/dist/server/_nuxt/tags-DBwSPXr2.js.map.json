r\n      <span class=\"text-white/60 ml-1\">{{ count }}</span>\r\n    </NuxtLink>\r\n  </div>\r\n</template>\r\n\r\n","<template>\r\n  <section class=\"space-y-6\">\r\n    <h1 class=\"text-2xl font-mono\">标签</h1>\r\n    <div class=\"flex flex-wrap gap-2\">\r\n      <TagCloud />\r\n    </div>\r\n  </section>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport TagCloud from '~/components/TagCloud.vue'\r\n</script>\r\n\r\n"],"version":3}